generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id               String           @id @default(cuid())
  name             String
  code             String           @unique
  state            String
  allowEvv         Boolean          @default(false)
  status           String           @default("Active")
  subscriptionPlan String?
  paymentMethod    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  email            String?
  numEmployees     Int              @default(0)
  phone            String?
  santraxID        String?
  addressLine1     String           @default("N/A")
  addressLine2     String?
  addressLine3     String?
  addressState     String           @default("N/A")
  city             String           @default("N/A")
  zipCode          String           @default("N/A")
  billingEmail     String?
  billingPhone     String?
  numClients       Int              @default(0)
  numVisits        Int              @default(0)
  paymentStatus    String           @default("Not Required")
  agencyAdminId    String?          @unique
  agencyAdmin      User?            @relation("AgencyAdminRelation", fields: [agencyAdminId], references: [id])
  invoices         Invoice[]
  RoleType         RoleType[]
  Task             Task[]
  users            User[]
  Visit            Visit[]
  TimelyAudit      TimelyAudit[]
  MobileEmployee   MobileEmployee[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agencyId        String?
  lastLogin       DateTime?
  passwordHash    String
  role            Role      @default(AGENCY_USER)
  isActive        Boolean   @default(true)
  phone           String?
  systemAdminUser Boolean   @default(false)
  roleTypeId      String?
  adminOfAgency   Agency?   @relation("AgencyAdminRelation")
  agency          Agency?   @relation(fields: [agencyId], references: [id])
  roleType        RoleType? @relation(fields: [roleTypeId], references: [id])
}

model RoleType {
  id          String       @id @default(cuid())
  name        String
  agencyId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  agency      Agency       @relation(fields: [agencyId], references: [id])
  TaskRole    TaskRole[]
  users       User[]
}

model Permission {
  id     String    @id @default(cuid())
  name   String
  roleId String?
  role   RoleType? @relation(fields: [roleId], references: [id])
}

model Visit {
  id                            Int              @id @default(autoincrement())
  agencyID                      String
  adjustedHours                 Float?
  adjustedIn                    DateTime?
  adjustedOut                   DateTime?
  approved                      Boolean?         @default(false)
  clientSignature               String?
  employeeSignature             String?
  visitSource                   String?
  mileage                       Float?
  authorizationReferenceNumber  String?
  location                      String?
  latitudeIn                    Float?
  longitudeIn                   Float?
  latitudeOut                   Float?
  longitudeOut                  Float?
  callType                      String?
  user                          String?
  claimID                       String?
  billHours                     Float?
  callHours                     Float?
  callIn                        DateTime?
  callOut                       DateTime?
  claimsVerificationStatus      String?
  clientID                      String?
  clientMedicaidID              String?
  clientName                    String?
  clientPrimaryPhoneNumber      String?
  clientVerified                Boolean?         @default(false)
  doNotBill                     Boolean?         @default(false)
  employeeContactPhoneNumber    String?
  employeeID                    String?
  employeeName                  String?
  employeeOtherID               String?
  exported                      Boolean?         @default(false)
  groupVisitCode                String?
  inOutCallLocation             String?
  memo                          String?
  payHours                      Float?
  payEqualsSch                  Boolean?         @default(false)
  payer                         String?
  program                       String?
  santraxID                     String?
  scheduledHours                Float?
  scheduledTimeIn               DateTime?
  scheduledTimeOut              DateTime?
  supervisor                    String?
  units                         Int?
  sandataAgencyID               String?
  visitTimeZone                 String?
  visitStatus                   VisitStatus      @default(Scheduled)
  actHoursVsSchHoursException   Boolean?         @default(false)
  actualTime                    Float?
  adjustedInTime                DateTime?
  adjustedOutTime               DateTime?
  adjustedTime                  Float?
  billTime                      Float?
  callInAddress                 String?
  callInType                    String?
  callOutAddress                String?
  callOutType                   String?
  clientSignatureException      Boolean?         @default(false)
  clientSignatureType           String?
  clientVerifiedService         String?
  clientVerifiedTime            DateTime?
  gpsInMilesFromClient          Float?
  gpsOutMilesFromClient         Float?
  inCall                        Boolean?         @default(false)
  missingLocationException      Boolean?         @default(false)
  missingPayerException         Boolean?         @default(false)
  missingServiceException       Boolean?         @default(false)
  noShowException               Boolean?         @default(false)
  outCall                       Boolean?         @default(false)
  providerID                    String?
  serviceVerificationException  Boolean?         @default(false)
  shortVisitException           Boolean?         @default(false)
  totalCurrentExceptions        Int?             @default(0)
  totalOriginalExceptions       Int?             @default(0)
  unauthorizedServiceException  Boolean?         @default(false)
  unknownClientException        Boolean?         @default(false)
  unknownEmployeeException      Boolean?         @default(false)
  unmatchedClientPhoneException Boolean?         @default(false)
  visitVerificationException    Boolean?         @default(false)
  visitWithoutAnyCallException  Boolean?         @default(false)
  visitWithoutInCallException   Boolean?         @default(false)
  visitWithoutOutCallException  Boolean?         @default(false)
  serviceId                     String?
  serviceName                   String?
  scheduleID                    String?          @unique
  missedVisits                  MissedVisit?     @relation("VisitToMissedVisit")
  agency                        Agency           @relation(fields: [agencyID], references: [id], onDelete: SetNull, onUpdate: NoAction)
  service                       Service?         @relation(fields: [serviceId], references: [id])
  exceptions                    VisitException[]
  history                       VisitHistory[]
  visitTasks                    VisitTask[]

  @@index([agencyID, scheduledTimeOut])
  @@index([agencyID, scheduledTimeIn])
  @@index([visitStatus])
  @@index([callIn, callOut])
}

model VisitTask {
  id        Int      @id @default(autoincrement())
  visitId   Int
  name      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VisitException {
  id            Int      @id @default(autoincrement())
  visitId       Int
  exceptionType String
  date          DateTime
  createdAt     DateTime @default(now())
  visit         Visit    @relation(fields: [visitId], references: [id])
}

model VisitHistory {
  id         Int      @id @default(autoincrement())
  visitId    Int
  title      String
  reasonCode String?
  reason     String?
  dateTime   DateTime
  updatedBy  String
  visit      Visit    @relation(fields: [visitId], references: [id])
}

model Employee {
  id                    String                @id @default(cuid())
  last5SSN              String
  status                String
  effectiveDate         DateTime              @updatedAt
  employeeID            String
  position              String
  hireDate              DateTime              @default(now())
  supervisor            String?
  supervisorCode        String?
  nationalProviderID    String?
  alternativeProviderID String?
  registryID            String?
  isSupervisor          Boolean               @default(false)
  name                  String
  dateOfBirth           DateTime              @default(now())
  gender                String
  languages             String[]
  mainPhone             String
  phone2                String?
  phone3                String?
  phone4                String?
  email                 String
  mobileUser            Boolean               @default(false)
  rehire                Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  agencyID              String
  firstName             String                @default("No")
  lastName              String                @default("Name")
  middleName            String?
  addresses             Address[]
  certifications        Certification[]
  contacts              Contact[]
  medicalInfos          EmployeeMedicalInfo[]
  employmentInfo        EmploymentInfo?
  mobileInfo            MobileEmployee?
  schedules             Schedule[]
  assignedClients       Client[]              @relation("EmployeeClients")
  officeStaff           Boolean               @default(false)
  facilityStaff         Boolean               @default(false)
}

model MobileEmployee {
  id           String   @id @default(cuid())
  employeeID   String   @unique
  email        String   @unique
  agencyID     String
  agencyCode   String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeID], references: [id])
  agency       Agency   @relation(fields: [agencyID], references: [id])
}

model EmploymentInfo {
  id                       String   @id @default(cuid())
  employeeID               String   @unique
  driversLicenseNumber     String
  driversLicenseExpiration DateTime
  insuranceStartDate       DateTime
  insuranceEndDate         DateTime
  insurancePolicyNumber    String
  carModel                 String?
  carMake                  String?
  carYear                  Int?
  carHandicapAccessible    Boolean  @default(false)
  registrationStartDate    DateTime
  registrationExpiration   DateTime
  physicalExamDate         DateTime
  tbShotDate               DateTime
  cprCertificationDate     DateTime
  employee                 Employee @relation(fields: [employeeID], references: [id])
}

model EmployeeMedicalInfo {
  id            String   @id @default(cuid())
  employeeID    String
  clearanceName String
  effectiveDate DateTime
  employee      Employee @relation(fields: [employeeID], references: [id])
}

model Certification {
  id              String   @id @default(cuid())
  employeeID      String
  name            String
  certificationID String?
  dateObtained    DateTime
  employee        Employee @relation(fields: [employeeID], references: [id])
}

model Contact {
  id                   String    @id @default(cuid())
  employeeID           String?
  clientID             String?
  title                String?
  firstName            String
  lastName             String
  middleInitial        String?
  suffix               String?
  gender               String?
  birthDate            DateTime?
  languages            String[]
  type                 String
  relation             String?
  mainEmergencyContact Boolean   @default(false)
  addressLine1         String
  addressLine2         String?
  addressType          String
  addressLabel         String?
  zipcode              String
  city                 String?
  county               String?
  state                String
  phone1               String?
  phone2               String?
  phone3               String?
  phone4               String?
  email                String?
  client               Client?   @relation(fields: [clientID], references: [id])
  employee             Employee? @relation(fields: [employeeID], references: [id])
}

model Address {
  id           String    @id @default(cuid())
  addressLabel String
  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  addressType  String
  zipcode      String
  state        String
  county       String?
  employeeID   String?
  clientID     String?
  city         String
  client       Client?   @relation(fields: [clientID], references: [id])
  employee     Employee? @relation(fields: [employeeID], references: [id])
}

model Client {
  id                String          @id @default(cuid())
  ssn               String
  status            String
  effectiveDate     DateTime        @updatedAt
  clientID          String
  startDate         DateTime        @default(now())
  endDate           DateTime?
  supervisor        String?
  medicaidID        String
  agencyID          String
  name              String
  dateOfBirth       DateTime
  gender            String
  languages         String[]
  mainPhone         String
  phone2            String?
  phone3            String?
  phone4            String?
  email             String
  programID         String?
  addresses         Address[]
  program           Program?        @relation(fields: [programID], references: [id])
  contacts          Contact[]
  invoices          Invoice[]
  schedules         Schedule[]
  authorizations    Authorization[] @relation("AuthorizationToClient")
  services          Service[]       @relation("ClientServices")
  payers            Payer[]         @relation("ClientToPayer")
  assignedEmployees Employee[]      @relation("EmployeeClients")
}

model Service {
  id             String          @id @default(cuid())
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  authorizations Authorization[]
  schedule       Schedule[]
  Visit          Visit[]
  assignedTo     Client[]        @relation("ClientServices")
}

model Program {
  id                   String   @id @default(cuid())
  supervisor           String?
  enrollmentDate       DateTime
  statusEffectiveDate  DateTime
  socDate              DateTime
  eocDate              DateTime
  eligibilityBeginDate DateTime
  eligibilityEndDate   DateTime
  createdDate          DateTime @default(now())
  reasonForChange      String?
  name                 String?
  clients              Client[]
}

model Payer {
  id              String          @id @default(cuid())
  payerName       String
  medicaidID      String
  rank            Int
  clientPayerID   String
  groupNo         String?
  startDate       DateTime
  endDate         DateTime
  authorizations  Authorization[]
  assignedClients Client[]        @relation("ClientToPayer")
}

model Invoice {
  id            String   @id @default(cuid())
  clientID      String
  invoiceNumber String   @unique
  amount        Float
  status        String   @default("Pending")
  dueDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  client        Client   @relation(fields: [clientID], references: [id])
}

model Authorization {
  id                  String       @id @default(cuid())
  payerID             String?
  serviceID           String?
  eventCode           String
  authorizationNumber String
  modifier1           String?
  modifier2           String?
  modifier3           String?
  modifier4           String?
  format              String
  voided              Boolean      @default(false)
  startDate           DateTime
  endDate             DateTime
  comments            String?
  visitsAllowed       String
  payer               Payer?       @relation(fields: [payerID], references: [id])
  service             Service?     @relation(fields: [serviceID], references: [id])
  limitations         Limitation[]
  assignedClients     Client[]     @relation("AuthorizationToClient")
}

model Limitation {
  id              String        @id @default(cuid())
  authorizationID String
  total           Int
  limitBy         String
  count           Int
  authorization   Authorization @relation(fields: [authorizationID], references: [id])
}

model Schedule {
  id                        String             @id @default(cuid())
  startTime                 DateTime
  endTime                   DateTime
  authorizationBillUnitType String
  authorizationNumber       String?
  authorizations            String?
  billAmount                Float?
  billingOverride           Boolean            @default(false)
  clientMedicaidId          String?
  comments                  String?
  copay                     Float?
  createdAt                 DateTime           @default(now())
  dates                     String[]
  eventCode                 String
  eventDate                 DateTime
  eventStatus               String
  officeReason              String?
  rate                      Float?
  scheduleType              String
  serviceId                 String?
  updatedAt                 DateTime           @updatedAt
  clientID                  String?
  employeeID                String?
  agencyID                  String             @default("UNITY124")
  recurring                 Boolean            @default(false)
  recurringFrequency        ScheduleFrequency?
  createdScheduleID         String? // shared group ID for multi-day creation
  recurringScheduleID       String? // shared ID for recurring sets
  missedVisits              MissedVisit[]      @relation("ScheduleToMissedVisit")
  client                    Client?            @relation(fields: [clientID], references: [id])
  employee                  Employee?          @relation(fields: [employeeID], references: [id])
  service                   Service?           @relation(fields: [serviceId], references: [id])
}

model ChatThread {
  id           String            @id @default(cuid())
  title        String?
  startedAt    DateTime          @default(now())
  agencyCode   String
  updatedAt    DateTime          @default(now())
  messages     ChatMessage[]
  participants ChatParticipant[]
  readReceipts ChatReadReceipt[]

  @@index([agencyCode, startedAt])
}

model ChatParticipant {
  id               String          @id @default(cuid())
  threadId         String
  userId           String?
  displayName      String
  mobileEmployeeId String?
  participantId    String
  participantType  ParticipantType
  thread           ChatThread      @relation(fields: [threadId], references: [id])

  @@unique([threadId, participantId])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderId   String
  content    String
  createdAt  DateTime   @default(now())
  senderType String
  thread     ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

model ChatReadReceipt {
  id            String     @id @default(cuid())
  threadId      String
  participantId String
  lastReadAt    DateTime   @default(now())
  thread        ChatThread @relation(fields: [threadId], references: [id])

  @@unique([threadId, participantId])
}

model MissedVisit {
  id                    String    @id @default(cuid())
  visitId               Int       @unique
  reason                String    @default("No Show")
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  rescheduled           Boolean   @default(false)
  replacementScheduleId String?
  replacementSchedule   Schedule? @relation("ScheduleToMissedVisit", fields: [replacementScheduleId], references: [id])
  visit                 Visit     @relation("VisitToMissedVisit", fields: [visitId], references: [id])

  @@index([expiresAt])
}

model Task {
  id            String        @id @default(uuid())
  name          String
  description   String?
  agencyId      String
  createdAt     DateTime      @default(now())
  assignedDate  DateTime?     @default(now())
  dueDate       DateTime
  isDone        Boolean       @default(false)
  isActive      Boolean       @default(true)
  recurring     Boolean       @default(false)
  frequency     Frequency?
  unityTask     Boolean       @default(false)
  completedAt   DateTime?
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedRoles TaskRole[]
  TimelyAudit   TimelyAudit[]
}

model TaskRole {
  id     String   @id @default(uuid())
  taskId String
  roleId String
  role   RoleType @relation(fields: [roleId], references: [id])
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TimelyAudit {
  id             String   @id @default(cuid())
  agencyId       String
  startDate      DateTime
  endDate        DateTime
  frequency      String
  createdById    String
  createdAt      DateTime @default(now())
  unityTaskId    String? // link to a Task if automated
  totalVisits    Int?
  evvCompliance  Float? // %
  gpsExceptions  Int?
  exceptionCount Int?
  completed      Boolean  @default(false)
  reportUrl      String? // optional, if PDF generated & saved

  agency    Agency @relation(fields: [agencyId], references: [id])
  unityTask Task?  @relation(fields: [unityTaskId], references: [id])

  @@unique([agencyId, frequency, startDate, endDate])
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  SPECIFIC_DATE
}

enum ChatStatus {
  pending
  active
  closed
}

enum ParticipantType {
  USER
  MOBILE_EMPLOYEE
  SYSTEM_ADMIN
}

enum Role {
  MAIN_ADMIN
  SYSTEM_ADMIN
  AGENCY_USER
  AGENCY_ADMIN
}

enum VisitStatus {
  Incomplete
  InProcess
  Verified
  Scheduled
  Processed
  Omitted
}

enum ScheduleFrequency {
  WEEKLY
  BIWEEKLY
}
