generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id               String     @id @default(cuid())
  name             String
  code             String     @unique
  state            String
  allowEvv         Boolean    @default(false)
  status           String     @default("Active")
  subscriptionPlan String?
  paymentMethod    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  email            String?
  numEmployees     Int        @default(0)
  phone            String?
  santraxID        String?
  addressLine1     String     @default("N/A")
  addressLine2     String?
  addressLine3     String?
  addressState     String     @default("N/A")
  city             String     @default("N/A")
  zipCode          String     @default("N/A")
  billingEmail     String?
  billingPhone     String?
  numClients       Int        @default(0)
  numVisits        Int        @default(0)
  paymentStatus    String     @default("Not Required")
  agencyAdminId    String?    @unique
  agencyAdmin      User?      @relation("AgencyAdminRelation", fields: [agencyAdminId], references: [id])
  invoices         Invoice[]
  RoleType         RoleType[]
  users            User[]
  Task             Task[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agencyId        String?
  lastLogin       DateTime?
  passwordHash    String
  role            Role      @default(AGENCY_USER)
  isActive        Boolean   @default(true)
  phone           String?
  systemAdminUser Boolean   @default(false)
  roleTypeId      String?
  adminOfAgency   Agency?   @relation("AgencyAdminRelation")
  agency          Agency?   @relation(fields: [agencyId], references: [id])
  roleType        RoleType? @relation(fields: [roleTypeId], references: [id])
}

model RoleType {
  id          String       @id @default(cuid())
  name        String
  agencyId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  agency      Agency       @relation(fields: [agencyId], references: [id])
  users       User[]
  TaskRole    TaskRole[]
}

model Permission {
  id     String    @id @default(cuid())
  name   String
  roleId String?
  role   RoleType? @relation(fields: [roleId], references: [id])
}

model Visit {
  id                    Int         @id @default(autoincrement())
  agencyID              String
  visitStatus           VisitStatus @default(Scheduled) // ✅ added VISIT_STATUS
  inCall                Boolean?    @default(false) // ✅ new
  callInType            String? // ✅ new
  callInAddress         String? // ✅ new
  outCall               Boolean?    @default(false) // ✅ new
  callOutType           String? // ✅ new
  callOutAddress        String? // ✅ new
  adjustedInTime        DateTime? // ✅ new
  adjustedOutTime       DateTime? // ✅ new
  actualTime            Float? // ✅ new (in hours or minutes — adjust to your logic)
  adjustedTime          Float? // ✅ new
  billTime              Float? // ✅ new
  units                 Int? // already exists
  gpsInMilesFromClient  Float? // ✅ GPS Call In Miles away from client address
  gpsOutMilesFromClient Float? // ✅ GPS Call Out Miles away from client address
  clientSignature       String?
  clientSignatureType   String? // ✅ new
  clientVerifiedTime    DateTime? // ✅ new
  clientVerifiedService String? // ✅ new

  // ✅ exception flags
  unknownClientException        Boolean? @default(false)
  unknownEmployeeException      Boolean? @default(false)
  visitWithoutInCallException   Boolean? @default(false)
  visitWithoutOutCallException  Boolean? @default(false)
  unmatchedClientPhoneException Boolean? @default(false)
  missingServiceException       Boolean? @default(false)
  unauthorizedServiceException  Boolean? @default(false)
  missingLocationException      Boolean? @default(false)
  visitWithoutAnyCallException  Boolean? @default(false)
  actHoursVsSchHoursException   Boolean? @default(false)
  missingPayerException         Boolean? @default(false)
  shortVisitException           Boolean? @default(false)
  noShowException               Boolean? @default(false)
  visitVerificationException    Boolean? @default(false)
  clientSignatureException      Boolean? @default(false)
  serviceVerificationException  Boolean? @default(false)

  totalOriginalExceptions Int? @default(0)
  totalCurrentExceptions  Int? @default(0)

  providerID String? // ✅ new

  // 🔁 Existing fields kept
  adjustedHours                Float?
  adjustedIn                   DateTime?
  adjustedOut                  DateTime?
  approved                     Boolean?  @default(false)
  employeeSignature            String?
  visitSource                  String?
  mileage                      Float?
  authorizationReferenceNumber String?
  location                     String?
  latitudeIn                   Float?
  longitudeIn                  Float?
  latitudeOut                  Float?
  longitudeOut                 Float?
  callType                     String?
  user                         String?
  claimID                      String?
  billHours                    Float?
  callHours                    Float?
  callIn                       DateTime?
  callOut                      DateTime?
  claimsVerificationStatus     String?
  clientID                     Int?
  clientMedicaidID             String?
  clientName                   String?
  clientPrimaryPhoneNumber     String?
  clientVerified               Boolean?  @default(false)
  doNotBill                    Boolean?  @default(false)
  employeeContactPhoneNumber   String?
  employeeID                   Int?
  employeeName                 String?
  employeeOtherID              String?
  exported                     Boolean?  @default(false)
  groupVisitCode               String?
  inOutCallLocation            String?
  memo                         String?
  payHours                     Float?
  payEqualsSch                 Boolean?  @default(false)
  payer                        String?
  program                      String?
  santraxID                    String?
  scheduledHours               Float?
  scheduledTimeIn              DateTime?
  scheduledTimeOut             DateTime?
  serviceId                    String?
  service                      Service?  @relation(fields: [serviceId], references: [id])
  serviceName                  String? // legacy field for backward compatibility

  supervisor String?

  // ✅ renamed from tasks to visitTasks
  visitTasks VisitTask[]

  sandataAgencyID String?
  visitTimeZone   String?
  missedVisits    MissedVisit?     @relation("VisitToMissedVisit")
  exceptions      VisitException[]
  history         VisitHistory[]

  @@index([agencyID, scheduledTimeOut])
  @@index([agencyID, scheduledTimeIn])
  @@index([visitStatus])
  @@index([callIn, callOut])
}

model VisitTask {
  id        Int      @id @default(autoincrement())
  visitId   Int
  name      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VisitException {
  id            Int      @id @default(autoincrement())
  visitId       Int
  exceptionType String
  date          DateTime
  createdAt     DateTime @default(now())
  visit         Visit    @relation(fields: [visitId], references: [id])
}

model VisitHistory {
  id         Int      @id @default(autoincrement())
  visitId    Int
  title      String
  reasonCode String?
  reason     String?
  dateTime   DateTime
  updatedBy  String
  visit      Visit    @relation(fields: [visitId], references: [id])
}

model Employee {
  id                    String                @id @default(cuid())
  last5SSN              String
  status                String
  effectiveDate         DateTime              @updatedAt
  employeeID            String
  position              String
  hireDate              DateTime              @default(now())
  supervisor            String?
  supervisorCode        String?
  nationalProviderID    String?
  alternativeProviderID String?
  registryID            String?
  isSupervisor          Boolean               @default(false)
  name                  String
  dateOfBirth           DateTime              @default(now())
  gender                String
  languages             String[]
  mainPhone             String
  phone2                String?
  phone3                String?
  phone4                String?
  email                 String
  mobileUser            Boolean               @default(false)
  rehire                Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  agencyID              String
  firstName             String                @default("No")
  lastName              String                @default("Name")
  middleName            String?
  addresses             Address[]
  certifications        Certification[]
  contacts              Contact[]
  medicalInfos          EmployeeMedicalInfo[]
  employmentInfo        EmploymentInfo?
  mobileInfo            MobileEmployee?
  schedules             Schedule[]
  assignedClients       Client[]              @relation("EmployeeClients")
}

model MobileEmployee {
  id           String   @id @default(cuid())
  employeeID   String   @unique
  email        String   @unique
  agencyCode   String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeID], references: [id])
}

model EmploymentInfo {
  id                       String   @id @default(cuid())
  employeeID               String   @unique
  driversLicenseNumber     String
  driversLicenseExpiration DateTime
  insuranceStartDate       DateTime
  insuranceEndDate         DateTime
  insurancePolicyNumber    String
  carModel                 String?
  carMake                  String?
  carYear                  Int?
  carHandicapAccessible    Boolean  @default(false)
  registrationStartDate    DateTime
  registrationExpiration   DateTime
  physicalExamDate         DateTime
  tbShotDate               DateTime
  cprCertificationDate     DateTime
  employee                 Employee @relation(fields: [employeeID], references: [id])
}

model EmployeeMedicalInfo {
  id            String   @id @default(cuid())
  employeeID    String
  clearanceName String
  effectiveDate DateTime
  employee      Employee @relation(fields: [employeeID], references: [id])
}

model Certification {
  id              String   @id @default(cuid())
  employeeID      String
  name            String
  certificationID String?
  dateObtained    DateTime
  employee        Employee @relation(fields: [employeeID], references: [id])
}

model Contact {
  id                   String    @id @default(cuid())
  employeeID           String?
  clientID             String?
  title                String?
  firstName            String
  lastName             String
  middleInitial        String?
  suffix               String?
  gender               String?
  birthDate            DateTime?
  languages            String[]
  type                 String
  relation             String?
  mainEmergencyContact Boolean   @default(false)
  addressLine1         String
  addressLine2         String?
  addressType          String
  addressLabel         String?
  zipcode              String
  city                 String?
  county               String?
  state                String
  phone1               String?
  phone2               String?
  phone3               String?
  phone4               String?
  email                String?
  client               Client?   @relation(fields: [clientID], references: [id])
  employee             Employee? @relation(fields: [employeeID], references: [id])
}

model Address {
  id           String    @id @default(cuid())
  addressLabel String
  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  addressType  String
  zipcode      String
  city         String
  state        String
  county       String?
  employeeID   String?
  clientID     String?
  client       Client?   @relation(fields: [clientID], references: [id])
  employee     Employee? @relation(fields: [employeeID], references: [id])
}

model Client {
  id                String          @id @default(cuid())
  ssn               String
  status            String
  effectiveDate     DateTime        @updatedAt
  clientID          String
  startDate         DateTime        @default(now())
  supervisor        String?
  medicaidID        String
  agencyID          String
  name              String
  dateOfBirth       DateTime
  gender            String
  languages         String[]
  mainPhone         String
  phone2            String?
  phone3            String?
  phone4            String?
  email             String
  programID         String?
  addresses         Address[]
  program           Program?        @relation(fields: [programID], references: [id])
  contacts          Contact[]
  invoices          Invoice[]
  schedules         Schedule[]
  authorizations    Authorization[] @relation("AuthorizationToClient")
  services          Service[]       @relation("ClientServices")
  payers            Payer[]         @relation("ClientToPayer")
  assignedEmployees Employee[]      @relation("EmployeeClients")
}

model Service {
  id             String          @id @default(cuid())
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  authorizations Authorization[]
  schedule       Schedule[]
  assignedTo     Client[]        @relation("ClientServices")
  Visit          Visit[]
}

model Program {
  id                   String   @id @default(cuid())
  name                 String?
  supervisor           String?
  enrollmentDate       DateTime
  statusEffectiveDate  DateTime
  socDate              DateTime
  eocDate              DateTime
  eligibilityBeginDate DateTime
  eligibilityEndDate   DateTime
  createdDate          DateTime @default(now())
  reasonForChange      String?
  clients              Client[]
}

model Payer {
  id              String          @id @default(cuid())
  payerName       String
  medicaidID      String
  rank            Int
  clientPayerID   String
  groupNo         String?
  startDate       DateTime
  endDate         DateTime
  authorizations  Authorization[]
  assignedClients Client[]        @relation("ClientToPayer")
}

model Invoice {
  id            String   @id @default(cuid())
  clientID      String
  invoiceNumber String   @unique
  amount        Float
  status        String   @default("Pending")
  dueDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  client        Client   @relation(fields: [clientID], references: [id])
}

model Authorization {
  id                  String       @id @default(cuid())
  payerID             String?
  serviceID           String?
  eventCode           String
  authorizationNumber String
  modifier1           String?
  modifier2           String?
  modifier3           String?
  modifier4           String?
  format              String
  voided              Boolean      @default(false)
  startDate           DateTime
  endDate             DateTime
  comments            String?
  visitsAllowed       String
  payer               Payer?       @relation(fields: [payerID], references: [id])
  service             Service?     @relation(fields: [serviceID], references: [id])
  limitations         Limitation[]
  assignedClients     Client[]     @relation("AuthorizationToClient")
}

model Limitation {
  id              String        @id @default(cuid())
  authorizationID String
  total           Int
  limitBy         String
  count           Int
  authorization   Authorization @relation(fields: [authorizationID], references: [id])
}

model Schedule {
  id                        String        @id @default(cuid())
  startTime                 DateTime
  endTime                   DateTime
  authorizationBillUnitType String
  authorizationNumber       String?
  authorizations            String?
  billAmount                Float?
  billingOverride           Boolean       @default(false)
  clientMedicaidId          String
  comments                  String?
  copay                     Float?
  createdAt                 DateTime      @default(now())
  dates                     String[]
  eventCode                 String
  eventDate                 DateTime
  eventStatus               String
  officeReason              String?
  rate                      Float?
  scheduleType              String
  serviceId                 String?
  updatedAt                 DateTime      @updatedAt
  clientID                  String
  employeeID                String?
  agencyID                  String        @default("UNITY124")
  recurring                 Boolean       @default(false)
  missedVisits              MissedVisit[] @relation("ScheduleToMissedVisit")
  client                    Client        @relation(fields: [clientID], references: [id])
  employee                  Employee?     @relation(fields: [employeeID], references: [id])
  service                   Service?      @relation(fields: [serviceId], references: [id])
}

model ChatThread {
  id           String            @id @default(cuid())
  title        String?
  startedAt    DateTime          @default(now())
  agencyCode   String
  updatedAt    DateTime          @default(now())
  messages     ChatMessage[]
  participants ChatParticipant[]
  readReceipts ChatReadReceipt[]

  @@index([agencyCode, startedAt])
}

model ChatParticipant {
  id               String          @id @default(cuid())
  threadId         String
  userId           String?
  displayName      String
  mobileEmployeeId String?
  participantId    String
  participantType  ParticipantType
  thread           ChatThread      @relation(fields: [threadId], references: [id])

  @@unique([threadId, participantId])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderId   String
  content    String
  createdAt  DateTime   @default(now())
  senderType String
  thread     ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

model ChatReadReceipt {
  id            String     @id @default(cuid())
  threadId      String
  participantId String
  lastReadAt    DateTime   @default(now())
  thread        ChatThread @relation(fields: [threadId], references: [id])

  @@unique([threadId, participantId])
}

model MissedVisit {
  id                    String    @id @default(cuid())
  visitId               Int       @unique
  reason                String    @default("No Show")
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  rescheduled           Boolean   @default(false)
  replacementScheduleId String?
  replacementSchedule   Schedule? @relation("ScheduleToMissedVisit", fields: [replacementScheduleId], references: [id])
  visit                 Visit     @relation("VisitToMissedVisit", fields: [visitId], references: [id])

  @@index([expiresAt])
}

model Task {
  id            String     @id @default(uuid())
  name          String
  description   String?
  agencyId      String
  agency        Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedRoles TaskRole[]
  createdAt     DateTime   @default(now())
  assignedDate  DateTime?  @default(now())
  dueDate       DateTime
  isDone        Boolean    @default(false)
  isActive      Boolean    @default(true)
  recurring     Boolean    @default(false)
  frequency     Frequency?
  unityTask     Boolean    @default(false) // true = Unity automated task
  completedAt   DateTime?
}

model TaskRole {
  id     String   @id @default(uuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  roleId String
  role   RoleType @relation(fields: [roleId], references: [id])
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  SPECIFIC_DATE
}

enum ChatStatus {
  pending
  active
  closed
}

enum ParticipantType {
  USER
  MOBILE_EMPLOYEE
  SYSTEM_ADMIN
}

enum Role {
  MAIN_ADMIN
  SYSTEM_ADMIN
  AGENCY_USER
  AGENCY_ADMIN
}

enum VisitStatus {
  Incomplete
  InProcess
  Verified
  Scheduled
  Processed
  Omitted
}
