generator client {
  provider = "prisma-client-js"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id               String    @id @default(cuid())
  name             String
  code             String    @unique
  state            String
  allowEvv         Boolean   @default(false)
  status           String    @default("Active")
  subscriptionPlan String?
  paymentMethod    String?
  email            String?
  phone            String?
  addressLine1     String    @default("N/A")
  addressLine2     String?
  addressLine3     String?
  city             String    @default("N/A")
  zipCode          String    @default("N/A")
  addressState     String    @default("N/A")
  numEmployees     Int       @default(0)
  numVisits        Int       @default(0)
  numClients       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  agencyAdminId    String?   @unique
  agencyAdmin      User?     @relation("AgencyAdminRelation", fields: [agencyAdminId], references: [id])
  santraxID        String?
  billingEmail     String?
  billingPhone     String?
  paymentStatus    String    @default("Not Required")
  invoices         Invoice[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agencyId        String?
  lastLogin       DateTime?
  passwordHash    String
  role            Role      @default(AGENCY_USER)
  agency          Agency?   @relation(fields: [agencyId], references: [id])
  adminOfAgency   Agency?   @relation("AgencyAdminRelation")
  isActive        Boolean   @default(true)
  systemAdminUser Boolean   @default(false)
}

model Visit {
  id                           Int              @id @default(autoincrement())
  agencyID                     String
  adjustedHours                Float?
  adjustedIn                   DateTime?
  adjustedOut                  DateTime?
  approved                     Boolean?         @default(false)
  clientSignature              String? // could store a file URL or base64 string
  employeeSignature            String? // same as above
  visitSource                  String?
  mileage                      Float?
  authorizationReferenceNumber String?
  location                     String? // Home / Community, etc.
  latitudeIn                   Float?
  longitudeIn                  Float?
  latitudeOut                  Float?
  longitudeOut                 Float?
  callType                     String? // MVV, Manual, etc.
  user                         String? // user who entered the visit
  exceptions                   VisitException[]
  history                      VisitHistory[]
  claimID                      String?
  billHours                    Float?
  callHours                    Float?
  callIn                       DateTime?
  callOut                      DateTime?
  claimsVerificationStatus     String?
  clientID                     Int?
  clientMedicaidID             String?
  clientName                   String?
  clientPrimaryPhoneNumber     String?
  clientVerified               Boolean?         @default(false)
  doNotBill                    Boolean?         @default(false)
  employeeContactPhoneNumber   String?
  employeeID                   Int?
  employeeName                 String?
  employeeOtherID              String?
  exported                     Boolean?         @default(false)
  groupVisitCode               String?
  inOutCallLocation            String?
  memo                         String?
  payHours                     Float?
  payEqualsSch                 Boolean?         @default(false)
  payer                        String?
  program                      String?
  santraxID                    String?
  scheduledHours               Float?
  scheduledTimeIn              DateTime?
  scheduledTimeOut             DateTime?
  service                      String?
  supervisor                   String?
  tasks                        String?
  units                        Int?
  visitFromDate                DateTime?
  sandataAgencyID              String?
  visitStatus                  VisitStatus      @default(Scheduled)
  visitTimeZone                String?
  missedVisits                 MissedVisit[]    @relation("VisitToMissedVisit")

  @@index([agencyID, scheduledTimeOut])
  @@index([agencyID, scheduledTimeIn])
  @@index([visitStatus])
  @@index([callIn, callOut])
}

model VisitException {
  id            Int      @id @default(autoincrement())
  visitId       Int
  exceptionType String
  date          DateTime
  createdAt     DateTime @default(now())
  // Relation
  visit         Visit    @relation(fields: [visitId], references: [id])
}

model VisitHistory {
  id         Int      @id @default(autoincrement())
  visitId    Int
  title      String
  reasonCode String?
  reason     String?
  dateTime   DateTime
  updatedBy  String
  // Relation
  visit      Visit    @relation(fields: [visitId], references: [id])
}

// ========================
// Employees & Related Info
// ========================
model Employee {
  id                    String                @id @default(cuid())
  last5SSN              String
  status                String // Active, Vacation, Inactive
  effectiveDate         DateTime              @updatedAt
  employeeID            String
  agencyID              String
  position              String
  hireDate              DateTime              @default(now())
  supervisor            String?
  supervisorCode        String?
  nationalProviderID    String?
  alternativeProviderID String?
  registryID            String?
  isSupervisor          Boolean               @default(false)
  name                  String
  firstName             String                @default("No")
  middleName            String?
  lastName              String                @default("Name")
  addresses             Address[]
  dateOfBirth           DateTime              @default(now())
  gender                String
  languages             String[]
  mainPhone             String
  phone2                String?
  phone3                String?
  phone4                String?
  email                 String
  mobileUser            Boolean               @default(false)
  rehire                Boolean               @default(false)
  contacts              Contact[]
  schedules             Schedule[] // will link later
  certifications        Certification[]
  employmentInfo        EmploymentInfo[]
  assignedClients       Client[]              @relation("EmployeeClients")
  medicalInfos          EmployeeMedicalInfo[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  mobileInfo            MobileEmployee? // One-to-one optional relation
}

model MobileEmployee {
  id           String   @id @default(cuid())
  employee     Employee @relation(fields: [employeeID], references: [id])
  employeeID   String   @unique // one-to-one relation with Employee
  email        String   @unique
  agencyCode   String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmploymentInfo {
  id                       String   @id @default(cuid())
  employee                 Employee @relation(fields: [employeeID], references: [id])
  employeeID               String   @unique
  driversLicenseNumber     String // **sensitive**
  driversLicenseExpiration DateTime
  insuranceStartDate       DateTime
  insuranceEndDate         DateTime
  insurancePolicyNumber    String // **sensitive**
  carModel                 String?
  carMake                  String?
  carYear                  Int?
  carHandicapAccessible    Boolean  @default(false)
  registrationStartDate    DateTime
  registrationExpiration   DateTime
  physicalExamDate         DateTime
  tbShotDate               DateTime
  cprCertificationDate     DateTime
}

model EmployeeMedicalInfo {
  id            String   @id @default(cuid())
  employee      Employee @relation(fields: [employeeID], references: [id])
  employeeID    String
  clearanceName String
  effectiveDate DateTime
}

model Certification {
  id              String   @id @default(cuid())
  employee        Employee @relation(fields: [employeeID], references: [id])
  employeeID      String
  name            String
  certificationID String?
  dateObtained    DateTime
}

// ========================
// Contacts & Addresses
// ========================
model Contact {
  id                   String    @id @default(cuid())
  employee             Employee? @relation(fields: [employeeID], references: [id])
  employeeID           String?
  client               Client?   @relation(fields: [clientID], references: [id])
  clientID             String?
  title                String?
  firstName            String
  lastName             String
  middleInitial        String?
  suffix               String?
  gender               String?
  birthDate            DateTime?
  languages            String[]
  type                 String // contact type
  relation             String?
  mainEmergencyContact Boolean   @default(false)
  addressLine1         String
  addressLine2         String?
  addressType          String
  addressLabel         String?
  zipcode              String
  city                 String?
  county               String?
  state                String
  phone1               String?
  phone2               String?
  phone3               String?
  phone4               String?
  email                String?
}

model Address {
  id           String    @id @default(cuid())
  addressLabel String
  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  addressType  String
  zipcode      String
  state        String
  county       String?
  employee     Employee? @relation(fields: [employeeID], references: [id])
  employeeID   String?
  client       Client?   @relation(fields: [clientID], references: [id])
  clientID     String?
}

// ========================
// Clients, Services, Program, Payer, Authorization
// ========================
model Client {
  id                String          @id @default(cuid())
  ssn               String
  status            String
  effectiveDate     DateTime        @updatedAt
  clientID          String
  startDate         DateTime        @default(now())
  supervisor        String?
  medicaidID        String
  agencyID          String
  contacts          Contact[]
  name              String
  dateOfBirth       DateTime
  gender            String
  languages         String[]
  mainPhone         String
  phone2            String?
  phone3            String?
  phone4            String?
  email             String
  schedules         Schedule[] // will link later
  assignedEmployees Employee[]      @relation("EmployeeClients")
  services          Service[]       @relation("ClientServices")
  program           Program?        @relation(fields: [programID], references: [id])
  programID         String?
  payers            Payer[]
  authorizations    Authorization[]
  invoices          Invoice[]
  addresses         Address[]
}

model Service {
  id             String          @id @default(cuid())
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  assignedTo     Client[]        @relation("ClientServices")
  authorizations Authorization[]
  schedule       Schedule[]
}

model Program {
  id                   String   @id @default(cuid())
  supervisor           String?
  enrollmentDate       DateTime
  statusEffectiveDate  DateTime
  socDate              DateTime
  eocDate              DateTime
  eligibilityBeginDate DateTime
  eligibilityEndDate   DateTime
  createdDate          DateTime @default(now())
  reasonForChange      String?
  clients              Client[]
}

model Payer {
  id              String          @id @default(cuid())
  assignedClients Client[]
  payerName       String
  medicaidID      String
  rank            Int
  clientPayerID   String
  groupNo         String?
  startDate       DateTime
  endDate         DateTime
  authorizations  Authorization[]
}

model Invoice {
  id            String   @id @default(cuid())
  clientID      String
  invoiceNumber String   @unique
  amount        Float
  status        String   @default("Pending") // Pending, Paid, Overdue
  dueDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client   Client @relation(fields: [clientID], references: [id])
  agency   Agency @relation(fields: [agencyId], references: [id])
  agencyId String
}

model Authorization {
  id                  String       @id @default(cuid())
  assignedClients     Client[]
  payer               Payer?       @relation(fields: [payerID], references: [id])
  payerID             String?
  service             Service?     @relation(fields: [serviceID], references: [id])
  serviceID           String?
  eventCode           String
  authorizationNumber String
  modifier1           String?
  modifier2           String?
  modifier3           String?
  modifier4           String?
  format              String
  voided              Boolean      @default(false)
  startDate           DateTime
  endDate             DateTime
  comments            String?
  visitsAllowed       String // unlimited / limited
  limitations         Limitation[]
}

model Limitation {
  id              String        @id @default(cuid())
  authorization   Authorization @relation(fields: [authorizationID], references: [id])
  authorizationID String
  total           Int
  limitBy         String // day, week, month, year, none
  count           Int
}

// ========================
// Schedule
// ========================
model Schedule {
  id                        String        @id @default(cuid())
  scheduleType              String
  clientID                  String
  client                    Client        @relation(fields: [clientID], references: [id])
  clientMedicaidId          String
  authorizations            String?
  authorizationNumber       String?
  serviceId                 String?
  service                   Service?      @relation(fields: [serviceId], references: [id])
  officeReason              String?
  eventCode                 String
  authorizationBillUnitType String
  eventStatus               String
  eventDate                 DateTime
  startTime                 DateTime
  endTime                   DateTime
  employeeID                String?
  employee                  Employee?     @relation(fields: [employeeID], references: [id])
  recurring                 Boolean       @default(false) // 🔄 renamed from repeatedEvent
  dates                     String[] // optional repeated dates
  comments                  String?
  billingOverride           Boolean       @default(false)
  rate                      Float?
  copay                     Float?
  billAmount                Float?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  agencyID                  String        @default("UNITY124")
  missedVisits              MissedVisit[] @relation("ScheduleToMissedVisit")
}

model ChatThread {
  id           String            @id @default(cuid())
  agencyCode   String
  title        String?
  type         ChatType // "user", "employee", "systemAdmin"
  status       ChatStatus        @default(active) // "pending", "active", "closed"
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([agencyCode, status, type])
}

model ChatParticipant {
  id               String         @id @default(cuid())
  threadId         String
  participantId    String
  participantType  ParticpantType
  displayName      String
  userId           String?
  mobileEmployeeId String?
  thread           ChatThread     @relation(fields: [threadId], references: [id])

  @@unique([threadId, participantId])
  @@index([threadId])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderId   String
  senderType String
  content    String
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id])
}

model MissedVisit {
  id          String   @id @default(cuid())
  visitId     Int      @unique
  reason      String   @default("No Show")
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  rescheduled Boolean  @default(false)

  replacementScheduleId String?
  replacementSchedule   Schedule? @relation("ScheduleToMissedVisit", fields: [replacementScheduleId], references: [id])
  visit                 Visit     @relation("VisitToMissedVisit", fields: [visitId], references: [id])

  @@index([expiresAt])
}

enum ChatType {
  user
  systemAdmin
}

enum ChatStatus {
  pending
  active
  closed
}

enum ParticpantType {
  USER
  MOBILE_EMPLOYEE
  SYSTEM_ADMIN
}

enum Role {
  MAIN_ADMIN
  SYSTEM_ADMIN
  AGENCY_USER
  AGENCY_ADMIN
}

enum VisitStatus {
  Incomplete
  InProcess
  Verified
  Scheduled
  Processed
  Omitted
}
