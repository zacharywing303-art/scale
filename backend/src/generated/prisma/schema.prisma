generator client {
  provider = "prisma-client-js"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  state            String
  allowEvv         Boolean  @default(false)
  status           String   @default("Active")
  subscriptionPlan String?
  paymentMethod    String?
  email            String?
  phone            String?
  addressLine1     String   @default("N/A")
  addressLine2     String?
  addressLine3     String?
  city             String   @default("N/A")
  zipCode          String   @default("N/A")
  addressState     String   @default("N/A")
  numEmployees     Int      @default(0)
  numVisits        Int      @default(0)
  numClients       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  users            User[]
  agencyAdminId    String?  @unique
  agencyAdmin      User?    @relation("AgencyAdminRelation", fields: [agencyAdminId], references: [id])
  santraxID        String?
  billingEmail     String?
  billingPhone     String?
  paymentStatus    String   @default("Not Required")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agencyId        String?
  lastLogin       DateTime?
  passwordHash    String
  role            Role      @default(AGENCY_USER)
  agency          Agency?   @relation(fields: [agencyId], references: [id])
  adminOfAgency   Agency?   @relation("AgencyAdminRelation")
  isActive        Boolean   @default(true)
  systemAdminUser Boolean   @default(false)
}

enum Role {
  MAIN_ADMIN
  SYSTEM_ADMIN
  AGENCY_USER
  AGENCY_ADMIN
}
